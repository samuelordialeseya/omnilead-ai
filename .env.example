# ─────────────────────────────────────────────
# OmniLead-AI Environment Configuration
# Copy this file to .env and fill in your keys
# ─────────────────────────────────────────────

# ── MOCK MODE ──────────────────────────────────
# Set to 'true' to run full pipeline with realistic synthetic data.
# No API keys or external services required. Great for demos & testing.
MOCK_MODE=true

# ── GEMINI AI ──────────────────────────────────
# Get your free key at: https://aistudio.google.com
# When set, MOCK_MODE is automatically ignored for the AI layer.
GEMINI_API_KEY=

# ── CONCURRENCY & RATE LIMITING ────────────────
# Max simultaneous HTTP connections to target websites
CONCURRENCY_LIMIT=5
# Max requests per second (respects scraping etiquette)
RATE_LIMIT_RPS=2.0
# Request timeout in seconds
REQUEST_TIMEOUT=15

# ── CRM WEBHOOK DISPATCHER ─────────────────────
# Paste your GoHighLevel, HubSpot, Zapier, or Make.com webhook URL here
CRM_WEBHOOK_URL=

# ── NOTIFICATIONS ──────────────────────────────
# Slack Incoming Webhook for hot-lead alerts (ICP score >= 80)
SLACK_WEBHOOK_URL=
# Discord Webhook URL (optional alternative)
DISCORD_WEBHOOK_URL=

# ── EXPORT ─────────────────────────────────────
OUTPUT_DIR=./output
LOG_LEVEL=INFO
